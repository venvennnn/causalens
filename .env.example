# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional alternatives
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Bright Data
BRIGHTDATA_API_TOKEN=

CNA_DISCOVERY_COLLECTOR=c_mt5waa7y28okohy2bb
CNA_ARTICLE_COLLECTOR=c_mt5xrjlvou8e3hv9h

EDGE_DISCOVERY_COLLECTOR=c_mt5x5mxs1yk83lb2ss
EDGE_ARTICLE_COLLECTOR=c_mt5xjcc52lzzkhyte1

VIR_DISCOVERY_COLLECTOR=c_mt5x1ux81pzkfi3gzf
VIR_ARTICLE_COLLECTOR=c_mt5xxz1h12rsttjaza

# Transport can be http or cli
BRIGHTDATA_TRANSPORT=cli

# GDELT Web NGrams (primary discovery; DOC 2.0 is optional fallback)
GDELT_DISCOVERY_MODE=ngrams
GDELT_DOC_FALLBACK=false
GDELT_NGRAM_LOOKBACK_HOURS=6
GDELT_NGRAM_LAG_MINUTES=5
GDELT_NGRAM_MAX_SNAPSHOTS=3
GDELT_NGRAM_ENGLISH_ONLY=true
GDELT_NGRAM_MIN_RELEVANCE_SCORE=8.0
MIN_BRIGHTDATA_RELEVANCE_SCORE=12.0
GDELT_CACHE_DIR=./data/gdelt
GDELT_TIMEOUT_S=90

NEXT_PUBLIC_API_URL=http://localhost:8000

# Production / Docker
PORT=8000
FRONTEND_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo resilience
USE_CACHED_DEMO_ON_FAILURE=true
